rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function validDriverLocation(loc) {
      return loc is map
        && loc.lat is number
        && loc.lng is number
        && loc.lat >= -35.5 && loc.lat <= -22.0
        && loc.lng >= 16.0 && loc.lng <= 33.5
        && (loc.lat != 0 || loc.lng != 0)
        && loc.heading is number
        && loc.heading >= 0 && loc.heading <= 360
        && loc.updatedAt == request.time;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Store / Restaurant profiles
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource == null || resource.data.merchantId == request.auth.uid || restaurantId == request.auth.uid);
    }

    // Product Catalog
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.merchantId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.merchantId == request.auth.uid || resource == null);
    }

    // Driver profiles & real-time telemetry
    match /drivers/{driverId} {
      allow read: if isOwner(driverId);
      allow create: if isOwner(driverId) && request.resource.data.isOnline == false;
      allow update: if isOwner(driverId) && (
        request.resource.data.isOnline == false ||
        resource.data.verificationStatus == 'approved' ||
        request.resource.data.verificationStatus == 'approved'
      );
      allow delete: if false;
    }

    // Driver ratings & reviews (read-only for the target driver)
    match /driverReviews/{reviewId} {
      allow read: if isAuthenticated() && resource.data.driverId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Customer, Merchant & Driver Orders
    // Drivers can ONLY read/update orders currently offered to them or assigned to them
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.merchantId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.offeredToDriverId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.merchantId == request.auth.uid ||
        resource.data.offeredToDriverId == request.auth.uid ||
        (
          resource.data.driverId == request.auth.uid &&
          (
            !('driverSessionId' in request.resource.data) ||
            !(resource.data.driverSessionId is string) ||
            request.resource.data.driverSessionId == resource.data.driverSessionId
          ) &&
          (
            !('driverLocation' in request.resource.data.diff(resource.data).affectedKeys()) ||
            validDriverLocation(request.resource.data.driverLocation)
          ) &&
          (
            !(request.resource.data.status == 'completed' || request.resource.data.deliveryStatus == 'delivered') ||
            (
              resource.data.deliveryOtp is string &&
              request.resource.data.proofOfDelivery.otpCode == resource.data.deliveryOtp
            )
          )
        )
      );
      allow delete: if false; // Orders should never be deleted by clients
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
